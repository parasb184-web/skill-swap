# Copy this file to server/.env and adjust as needed.
# Every value below is optional — the server falls back to these same defaults.

# Port the Express + Socket.io server listens on
PORT=5050

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/skillswap

# Secret used to sign JWTs. Change this to a long random string.
JWT_SECRET=skillswap_jwt_secret_token_12345

# Base URL of the Python Flask recommendation service
ML_SERVICE_URL=http://localhost:5000

# 'development' or 'production'
NODE_ENV=development
